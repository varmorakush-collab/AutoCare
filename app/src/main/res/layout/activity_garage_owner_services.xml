<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#F4F7FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:background="#FFFFFF"
            android:elevation="2dp">

            <ImageView
                android:id="@+id/backImageView"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_arrow_back"
                android:padding="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                app:tint="#0F172A"
                android:contentDescription="Back"
                android:layout_marginEnd="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Garage Service Records"
                android:textColor="#0F172A"
                android:textSize="20sp"
                android:fontFamily="sans-serif-bold"
                android:letterSpacing="-0.01" />
        </LinearLayout>

        <!-- Modern Search Bar & Filter Chips -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/action_card_bg"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:elevation="1dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_search"
                    android:contentDescription="@null"
                    android:layout_marginEnd="12dp" />

                <EditText
                    android:id="@+id/searchEditText"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Search by mechanic, customer, or vehicle..."
                    android:inputType="text"
                    android:imeOptions="actionSearch"
                    android:textColor="#1E293B"
                    android:textColorHint="#94A3B8"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif" />

                <ImageView
                    android:id="@+id/btnClearSearch"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_close"
                    android:padding="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Clear"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Quick Filter Chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:overScrollMode="never"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/chipAll"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/chip_selected_bg"
                        app:backgroundTint="@null"
                        android:stateListAnimator="@null"
                        android:text="All Services"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:textAllCaps="false"
                        android:paddingHorizontal="16dp"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/chipPending"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/chip_unselected_bg"
                        app:backgroundTint="@null"
                        android:stateListAnimator="@null"
                        android:text="Pending"
                        android:textColor="#1E293B"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:textAllCaps="false"
                        android:paddingHorizontal="16dp"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/chipInProgress"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/chip_unselected_bg"
                        app:backgroundTint="@null"
                        android:stateListAnimator="@null"
                        android:text="In Progress"
                        android:textColor="#1E293B"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:textAllCaps="false"
                        android:paddingHorizontal="16dp"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/chipCompleted"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/chip_unselected_bg"
                        app:backgroundTint="@null"
                        android:stateListAnimator="@null"
                        android:text="Completed"
                        android:textColor="#1E293B"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:textAllCaps="false"
                        android:paddingHorizontal="16dp" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Scrollable Services List -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/servicesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="80dp">

                <TextView
                    android:id="@+id/emptyServicesTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No service records found for your garage."
                    android:textColor="#94A3B8"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:paddingHorizontal="32dp"
                    android:paddingVertical="48dp"
                    android:visibility="gone" />

            </LinearLayout>
        </ScrollView>

        <!-- Bottom Navigation Bar (Home, Mechanics, Services, Profile) -->
    <include layout="@layout/nav_garage_owner" />

</LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
