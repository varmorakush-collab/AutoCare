<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/splash_gradient_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="#F3F4F6"
        android:elevation="4dp">

        <ImageView
            android:id="@+id/backImageView"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_arrow_back"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@null"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Service"
            android:textColor="@color/splash_text_primary"
            android:textSize="20sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.01" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="20dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="20dp"
                android:elevation="6dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SERVICE FOR"
                    android:textColor="@color/splash_text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.04"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvCustomerNameSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/splash_text_primary"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tvVehicleDetailsSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/splash_accent_teal"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="24dp"
                android:elevation="6dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Service Details"
                    android:textColor="@color/splash_text_primary"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="20dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SERVICE DATE"
                    android:textColor="@color/splash_text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.04"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvServiceDate"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/input_bg"
                    android:textColor="@color/splash_text_primary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif"
                    android:paddingHorizontal="16dp"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginBottom="20dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SERVICE TYPE"
                    android:textColor="@color/splash_text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.04"
                    android:layout_marginBottom="8dp" />

                <Spinner
                    android:id="@+id/serviceTypeSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/input_bg"
                    android:paddingHorizontal="12dp"
                    android:layout_marginBottom="20dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CUSTOMER COMPLAINT"
                    android:textColor="@color/splash_text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.04"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/complaintEditText"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:hint="Describe customer complaint"
                    android:inputType="textMultiLine|textCapSentences"
                    android:imeOptions="actionNext"
                    android:gravity="top|start"
                    android:background="@drawable/input_bg"
                    android:textColor="@color/splash_text_primary"
                    android:textColorHint="@color/splash_text_secondary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif"
                    android:padding="16dp"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginBottom="20dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="WORK DONE / REPAIR DETAILS"
                    android:textColor="@color/splash_text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.04"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/workDoneEditText"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:hint="Describe repair work done"
                    android:inputType="textMultiLine|textCapSentences"
                    android:imeOptions="actionNext"
                    android:gravity="top|start"
                    android:background="@drawable/input_bg"
                    android:textColor="@color/splash_text_primary"
                    android:textColorHint="@color/splash_text_secondary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif"
                    android:padding="16dp"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginBottom="20dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="MECHANIC NOTES (OPTIONAL)"
                    android:textColor="@color/splash_text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.04"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/notesEditText"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:hint="Additional notes"
                    android:inputType="textMultiLine|textCapSentences"
                    android:imeOptions="actionNext"
                    android:gravity="top|start"
                    android:background="@drawable/input_bg"
                    android:textColor="@color/splash_text_primary"
                    android:textColorHint="@color/splash_text_secondary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif"
                    android:padding="16dp"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginBottom="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="24dp"
                android:elevation="6dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Billing &amp; Status"
                    android:textColor="@color/splash_text_primary"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="20dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="20dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="8dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="LABOUR CHARGES"
                            android:textColor="@color/splash_text_secondary"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.04"
                            android:layout_marginBottom="8dp" />

                        <EditText
                            android:id="@+id/labourEditText"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:hint="0.0"
                            android:inputType="numberDecimal"
                            android:imeOptions="actionNext"
                            android:background="@drawable/input_bg"
                            android:textColor="@color/splash_text_primary"
                            android:textColorHint="@color/splash_text_secondary"
                            android:textSize="15sp"
                            android:fontFamily="sans-serif"
                            android:paddingHorizontal="16dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="OTHER CHARGES"
                            android:textColor="@color/splash_text_secondary"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.04"
                            android:layout_marginBottom="8dp" />

                        <EditText
                            android:id="@+id/otherChargesEditText"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:hint="0.0"
                            android:inputType="numberDecimal"
                            android:imeOptions="actionNext"
                            android:background="@drawable/input_bg"
                            android:textColor="@color/splash_text_primary"
                            android:textColorHint="@color/splash_text_secondary"
                            android:textSize="15sp"
                            android:fontFamily="sans-serif"
                            android:paddingHorizontal="16dp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="DISCOUNT (OPTIONAL)"
                    android:textColor="@color/splash_text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.04"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/discountEditText"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="0.0"
                    android:inputType="numberDecimal"
                    android:imeOptions="actionDone"
                    android:background="@drawable/input_bg"
                    android:textColor="@color/splash_text_primary"
                    android:textColorHint="@color/splash_text_secondary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif"
                    android:paddingHorizontal="16dp"
                    android:layout_marginBottom="24dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp"
                    android:background="@drawable/input_bg"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Total Cost"
                        android:textColor="@color/splash_text_primary"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/totalCostTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.0"
                        android:textColor="@color/splash_accent_teal"
                        android:textSize="20sp"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SERVICE STATUS"
                    android:textColor="@color/splash_text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.04"
                    android:layout_marginBottom="8dp" />

                <Spinner
                    android:id="@+id/serviceStatusSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/input_bg"
                    android:paddingHorizontal="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PAYMENT STATUS"
                    android:textColor="@color/splash_text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.04"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp" />

                <Spinner
                    android:id="@+id/paymentStatusSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/input_bg"
                    android:paddingHorizontal="12dp" />
            </LinearLayout>

            <Button
                android:id="@+id/saveServiceButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/btn_primary_bg"
                app:backgroundTint="@null"
                android:elevation="2dp"
                android:stateListAnimator="@null"
                android:text="Save Service &amp; Add Parts"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.02"
                android:textAllCaps="false"
                android:layout_marginBottom="16dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>