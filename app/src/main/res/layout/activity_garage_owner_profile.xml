<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="#F4F7FB">

    <!-- Top Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="#FFFFFF"
        android:elevation="2dp">

        <ImageView
            android:id="@+id/backImageView"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_arrow_back"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            app:tint="#0F172A"
            android:contentDescription="Back"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Garage Profile"
            android:textColor="#0F172A"
            android:textSize="20sp"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="-0.01" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="20dp"
            android:paddingBottom="80dp">

            <!-- Profile Header Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp"
                app:cardUseCompatPadding="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="24dp">

                    <FrameLayout
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/icon_box_teal"
                        android:layout_marginBottom="14dp">
                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_car"
                            app:tint="#00A86B"
                            android:contentDescription="@null" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvGarageHeaderName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#0F141C"
                        android:textSize="20sp"
                        android:fontFamily="sans-serif-bold"
                        android:layout_marginBottom="6dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/icon_box_teal"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_verified"
                            android:layout_marginEnd="6dp"
                            android:contentDescription="@null" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Verified AutoCare Garage"
                            android:textColor="#00A86B"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_location_on"
                            android:layout_marginEnd="4dp"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/tvGarageHeaderAddress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#627282"
                            android:textSize="13sp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Account Details Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp"
                app:cardUseCompatPadding="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="GARAGE &amp; OWNER DETAILS"
                        android:textColor="#627282"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.04"
                        android:layout_marginBottom="16dp" />

                    <!-- Garage Name -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="GARAGE NAME"
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.04"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/etGarageName"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/input_bg"
                        android:textColor="#1E293B"
                        android:textColorHint="#94A3B8"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium"
                        android:enabled="false"
                        android:paddingHorizontal="16dp"
                        android:inputType="text|textCapWords"
                        android:layout_marginBottom="16dp" />

                    <!-- Owner Full Name -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="OWNER FULL NAME"
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.04"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/etOwnerName"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/input_bg"
                        android:textColor="#1E293B"
                        android:textColorHint="#94A3B8"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium"
                        android:enabled="false"
                        android:paddingHorizontal="16dp"
                        android:inputType="textPersonName|textCapWords"
                        android:layout_marginBottom="16dp" />

                    <!-- Email -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="EMAIL ADDRESS"
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.04"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/tvGarageEmail"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:gravity="center_vertical"
                        android:background="@drawable/input_bg"
                        android:textColor="#64748B"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium"
                        android:paddingHorizontal="16dp"
                        android:layout_marginBottom="16dp" />

                    <!-- Phone -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="PHONE NUMBER"
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.04"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/etGaragePhone"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/input_bg"
                        android:textColor="#1E293B"
                        android:textColorHint="#94A3B8"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium"
                        android:enabled="false"
                        android:paddingHorizontal="16dp"
                        android:inputType="phone"
                        android:layout_marginBottom="16dp" />

                    <!-- Address -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="GARAGE ADDRESS"
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.04"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/etGarageAddress"
                        android:layout_width="match_parent"
                        android:layout_height="90dp"
                        android:gravity="top|start"
                        android:background="@drawable/input_bg"
                        android:textColor="#1E293B"
                        android:textColorHint="#94A3B8"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium"
                        android:enabled="false"
                        android:padding="16dp"
                        android:inputType="text|textCapSentences"
                        android:layout_marginBottom="16dp" />

                    <!-- Edit Profile Button -->
                    <Button
                        android:id="@+id/btnEditGarageProfile"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/input_bg"
                        app:backgroundTint="@null"
                        android:stateListAnimator="@null"
                        android:drawableStart="@drawable/ic_edit"
                        android:paddingHorizontal="16dp"
                        app:tint="#00A86B"
                        android:text="  Edit Garage Profile"
                        android:textColor="#00A86B"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium"
                        android:textAllCaps="false" />

                    <Button
                        android:id="@+id/btnSaveGarageProfile"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/btn_primary_bg"
                        app:backgroundTint="@null"
                        android:stateListAnimator="@null"
                        android:text="Save Changes"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium"
                        android:textAllCaps="false"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/btnCancelGarageEdit"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/theme3_card_bg"
                        app:backgroundTint="@null"
                        android:stateListAnimator="@null"
                        android:text="Cancel"
                        android:textColor="#64748B"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium"
                        android:textAllCaps="false"
                        android:visibility="gone" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Log Out Button -->
            <Button
                android:id="@+id/btnLogoutButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/theme3_card_bg"
                app:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:drawableStart="@drawable/ic_logout"
                android:paddingHorizontal="16dp"
                android:text="  Log Out"
                android:textColor="#DC2626"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:textAllCaps="false" />

            <!-- Delete Account Button -->
            <Button
                android:id="@+id/btnDeleteAccountButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/theme3_card_bg"
                app:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:drawableStart="@drawable/ic_delete"
                android:paddingHorizontal="16dp"
                android:text="  Delete Account"
                android:textColor="#E11D48"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:textAllCaps="false" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar -->
    <include layout="@layout/nav_garage_owner" />

</LinearLayout>
