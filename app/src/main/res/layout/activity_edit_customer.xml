<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F7FB">

    <!-- Top Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="18dp"
        android:background="#FFFFFF"
        android:elevation="2dp">

        <ImageView
            android:id="@+id/backImageView"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_arrow_back"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            app:tint="#0F172A"
            android:contentDescription="Back"
            android:layout_marginEnd="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit Customer"
            android:textColor="#0F172A"
            android:textSize="20sp"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="-0.01" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="20dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/action_card_bg"
                android:padding="20dp"
                android:elevation="2dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Customer Information"
                    android:textColor="#0F172A"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-bold"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="FULL NAME"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.04"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/customerNameEditText"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="Enter full name"
                    android:inputType="textPersonName|textCapWords"
                    android:imeOptions="actionNext"
                    android:background="@drawable/input_bg"
                    android:textColor="#1E293B"
                    android:textColorHint="#94A3B8"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif"
                    android:paddingHorizontal="16dp"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="MOBILE NUMBER"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.04"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/customerMobileEditText"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="10-digit mobile number"
                    android:inputType="phone"
                    android:imeOptions="actionNext"
                    android:background="@drawable/input_bg"
                    android:textColor="#1E293B"
                    android:textColorHint="#94A3B8"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif"
                    android:paddingHorizontal="16dp"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="EMAIL ADDRESS"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.04"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/customerEmailEditText"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="name@example.com"
                    android:inputType="textEmailAddress"
                    android:imeOptions="actionNext"
                    android:background="@drawable/input_bg"
                    android:textColor="#1E293B"
                    android:textColorHint="#94A3B8"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif"
                    android:paddingHorizontal="16dp"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ADDRESS (OPTIONAL)"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.04"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/customerAddressEditText"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:hint="Enter address"
                    android:inputType="textMultiLine|textCapSentences"
                    android:imeOptions="actionDone"
                    android:gravity="top|start"
                    android:background="@drawable/input_bg"
                    android:textColor="#1E293B"
                    android:textColorHint="#94A3B8"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif"
                    android:padding="16dp"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginBottom="4dp" />
            </LinearLayout>

            <Button
                android:id="@+id/updateCustomerButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/btn_primary_bg"
                app:backgroundTint="@null"
                android:elevation="4dp"
                android:stateListAnimator="@null"
                android:text="Update Customer"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.02"
                android:textAllCaps="false"
                android:layout_marginBottom="16dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
